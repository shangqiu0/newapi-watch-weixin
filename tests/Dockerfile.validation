# Build production image first: docker build -t newapi-watch:local .
FROM newapi-watch:local
USER root
RUN pip install --no-cache-dir pytest==9.0.3 pytest-asyncio==1.3.0 pytest-cov==7.1.0
WORKDIR /checks
COPY pyproject.toml ./
COPY tests ./tests
RUN mkdir -p /checks/artifacts && chown -R watcher:watcher /checks
USER 10001:10001
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["--cov=newapi_watch", "--cov-report=term-missing", "--cov-fail-under=80", "-q"]
