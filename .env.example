# NewAPI Watch — 单权限独立监控服务
WATCH_DEMO=false
WATCH_DATABASE=data/watch.sqlite3
WATCH_TIMEZONE=Asia/Shanghai

# NewAPI 管理访问令牌（不是 /v1 模型转发用的 sk- API key）
WATCH_NEWAPI_URL=https://your-newapi.example.com
WATCH_NEWAPI_TOKEN=
WATCH_NEWAPI_USER_ID=1

# 仅用于 HTTP 运维接口，至少 24 位随机字符；不代表用户角色
WATCH_API_KEY=

# 告警、恢复、日报的群机器人 webhook；为空则不外发，队列保持 pending
WATCH_GROUP_WEBHOOK=

# 企微智能机器人 API 模式 / 长连接（群 @ 与私聊）
WATCH_BOT_ID=
WATCH_BOT_SECRET=

WATCH_POLL_SECONDS=30
WATCH_LOG_SECONDS=120
WATCH_LOG_INITIAL_HOURS=24
WATCH_LOG_OVERLAP_SECONDS=120
WATCH_PAGE_SIZE=100
WATCH_MAX_PAGES=1000
WATCH_RETENTION_DAYS=30
WATCH_REQUEST_TIMEOUT=15
WATCH_REQUEST_ATTEMPTS=3

# 主动探测可能花费额度且有上游副作用，默认关闭；所有使用者统一开关
WATCH_PROBE_ENABLED=false
WATCH_PROBE_SECONDS=600
WATCH_PROBE_FAILURES=3
WATCH_PROBE_CONCURRENCY=2

# 可选余额阈值，未配置不检查；不要设置为空字符串
# WATCH_LOW_BALANCE_THRESHOLD=10
WATCH_ERROR_RATIO_THRESHOLD=0.3
WATCH_ERROR_MIN_RECORDS=10

# 新API事件只是快速核查提示；没有可达回调地址时只使用轮询
WATCH_WEBHOOK_ENABLED=false
WATCH_WEBHOOK_SECRET=
WATCH_WEBHOOK_MAX_AGE=300

WATCH_REPORT_ENABLED=true
WATCH_REPORT_HOUR=9
WATCH_NOTIFICATION_INTERVAL=3.4
WATCH_NOTIFICATION_MAX_ATTEMPTS=8
WATCH_NOTIFICATION_RETRY_SECONDS=5

# 仅加载明确启用且已安装的可信扩展，不从群聊安装代码
WATCH_PLUGINS=[]
# 同渠道探测至少间隔30秒（手动与定时任务共用，避免并发重复收费）
WATCH_PROBE_MIN_INTERVAL=30

# 企微自然语言回答：模型理解问题 -> 只读工具查询当前平台 -> 自然语言回复
# 管理令牌不等于模型调用Key；下列模型Key必须单独填写。
WATCH_LLM_ENABLED=false
WATCH_LLM_BASE_URL=
WATCH_LLM_API_KEY=
WATCH_LLM_MODEL=
WATCH_PLATFORM_NAME=NewAPI平台

# 1.1 查询引擎（可选Redis缓存；不配置时使用有界内存缓存，任务进度仍由平台SQLite持久化）
# 安装Redis支持：uv sync --extra redis
# Redis地址中的密码只放在本地.env，不要提交仓库
# Docker Compose无需填写此项，默认通过内网连接redis://redis:6379/0；不要在容器里填写127.0.0.1
# 下例仅适用于Python直接运行并连接宿主Redis；显式留空可禁用应用Redis缓存
# WATCH_QUERY_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
WATCH_QUERY_CACHE_TTL_SECONDS=30
# 每次后台批处理最多读取页数、最长处理秒数、累计请求预算
WATCH_QUERY_TASK_REQUEST_BUDGET=5
WATCH_QUERY_TASK_SECONDS_BUDGET=20
WATCH_QUERY_TASK_MAX_REQUESTS=10000
